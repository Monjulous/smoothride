        function initMap() {


            var startP = new google.maps.LatLng(<?php echo $ride[0]['pick_lat']; ?>, <?php echo $ride[0]['pick_long']; ?>),

                <?php if(!empty($raw)) {  $i=1; foreach ($raw as $key => $value) {?>
            stop<?php echo $i; ?> = new google.maps.LatLng(<?php echo $value->lat; ?>, <?php echo $value->long; ?>),

                <?php $i++; } } ?>

            endP = new google.maps.LatLng(<?php echo $ride[0]['drop_lat']; ?>, <?php echo $ride[0]['drop_long']; ?>),
                myOptions = {
                    zoom: 7,
                    center: startP
                },
                map = new google.maps.Map(document.getElementById('map'), myOptions),
                // Instantiate a directions service.
                directionsService = new google.maps.DirectionsService,
                directionsDisplay = new google.maps.DirectionsRenderer({
                    map: map
                }),
                markerStart = new google.maps.Marker({
                    position: startP,
                    title: "Start Point",
                    label: "Start",
                    map: map
                }),
                <?php if(!empty($raw)) { $i=1; foreach ($raw as $key => $value) {?>
            markerStop1 = new google.maps.Marker({
                    position: stop<?php echo $i; ?>,
                    title: "",
                    label: "",
                    map: map
                }),
                <?php $i++; } } ?>

            markerEnd = new google.maps.Marker({
                position: endP,
                title: "End Point",
                label: "End",
                map: map
            });

            waypoints = [<?php  if(!empty($raw)) { $i=1; foreach ($raw as $key => $value) { ?> {
                location: stop<?php echo $i; ?>,
                stopover: true
            }, <?php $i++; } } ?>];
            // waypoints = [{location: stop1, stopover: true}];
            // get route from A to B
            calculateAndDisplayRoute(directionsService, directionsDisplay, startP, endP, waypoints);
        }



        function calculateAndDisplayRoute(directionsService, directionsDisplay, startP, endP, waypoints) {
            directionsService.route({
                origin: startP,
                waypoints: waypoints,
                destination: endP,
                avoidTolls: true,
                avoidHighways: false,
                travelMode: google.maps.TravelMode.DRIVING
            }, function(response, status) {
                if (status == google.maps.DirectionsStatus.OK) {
                    directionsDisplay.setDirections(response);
                } else {
                    window.alert('Directions request failed due to ' + status);
                }
            });
        }

        initMap();
    </script>

