{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^7.3|^8.2.25",
        "alexusmai/laravel-file-manager": "^2.5",
        "brian2694/laravel-toastr": "^5.56",
        "davejamesmiller/laravel-breadcrumbs": "5.x",
        "fideloper/proxy": "^4.2",
        "fruitcake/laravel-cors": "^2.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "haruncpi/laravel-log-reader": "^1.0",
        "haruncpi/laravel-user-activity": "^1.0",
        "intervention/image": "^2.5",
        "intervention/imagecache": "^2.5",
        "kreait/laravel-firebase": "^4.2",
        "laravel/framework": "^8.0",
        "laravel/passport": "^10.0",
        "laravel/tinker": "^2.0",
        "laravel/ui": "^3.0",
        "laravelcollective/html": "^6.2",
        "spatie/laravel-menu": "^3.7",
        "spatie/laravel-permission": "^3.17",
        "yajra/laravel-datatables": "1.5",
        "yajra/laravel-datatables-buttons": "^4.10",
        "yajra/laravel-datatables-oracle": "^9.11",
        "dedoc/scramble": "^0.8.6",
        "knuckleswtf/scribe": "^4.31"
    },
    "require-dev": {
        "facade/ignition": "^2.3.6",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^5.0",
        "phpunit/phpunit": "^9.3",
        "fakerphp/faker": "^1.24"
    },
    "config": {
    "allow-plugins": {
        "pestphp/pest-plugin": true,
        "php-http/discovery": true
    },
    "audit": {
        "ignore": ["PKSA-1wr2-d1dm-qbvs", "PKSA-hxrf-fpvh-g3vm"]
    },
    "platform": {
        "php":"8.4.16"
    }
},
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/dusk"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/Sendsms.php",
            "app/Helpers/PhonePeHelper.php"
           
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
